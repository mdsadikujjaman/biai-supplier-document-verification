# LLM Configuration (OpenAI, Gemini, or Mock / Deterministic mode)
# If no API key is provided, the system seamlessly operates in robust deterministic extraction mode.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Rule Threshold Configurations
PRICE_REJECTION_THRESHOLD=0.03
PRICE_REVIEW_THRESHOLD=0.00
QUANTITY_TOLERANCE_THRESHOLD=0.05
MAX_ADVANCE_PAYMENT_PCT=20.0
MIN_LATE_PENALTY_PCT_PER_WEEK=0.5
MAX_DELIVERY_DAYS=45
MIN_DELIVERY_DAYS_REVIEW=31
MIN_CREDIT_DAYS_REVIEW=30
MAX_CREDIT_DAYS_REVIEW=60
MIN_QUOTATION_VALIDITY_DAYS=30
STANDARD_VAT_RATE=0.15
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# Application Settings
DATA_DIR=sample_data
REPORTS_DIR=reports
LOG_LEVEL=INFO

